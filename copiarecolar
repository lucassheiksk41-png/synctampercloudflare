// ==UserScript==
// @name         SYNC MASTER - TVS (Sniper Nativo)
// @namespace    http://tampermonkey.net/
// @version      2.0
// @description  Bolha M Roxa + Botão Sync na Tabela (Leitura Direta Anti-Erros)
// @author       Comandante & Omini
// @match        *://*.lookdefense.top/*
// @match        *://lookdefense.top/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    if (document.getElementById('omini-bolha-tvs-wrapper')) return;

    console.log("🟪 SYNC MASTER - TVS: Script iniciado (Versão 2.0 - Sniper Nativo na Tabela)...");

    // Mantém a memória global para compatibilidade com o Worker antigo
    window.lastTvsData = { u: '', p: '', e: '', n: '' };

    // ==========================================
    // 🎨 ESTILOS PREMIUM ROXO (M e Botões da Tabela)
    // ==========================================
    const stylePremium = document.createElement('style');
    stylePremium.innerHTML = `
        #omini-sync-card-premium {
            background: #0f172a !important; border: 1px solid #8b5cf6 !important;
            border-radius: 8px !important; box-shadow: 0 10px 25px rgba(0,0,0,0.9), 0 0 10px rgba(139, 92, 246, 0.3) !important;
            font-family: 'Segoe UI', sans-serif !important;
        }
        #omini-sync-card-premium * { color: #f8fafc !important; border-color: #334155 !important; }
        #omini-sync-card-premium input, #omini-sync-card-premium textarea, #omini-sync-card-premium select {
            background: #020617 !important; color: #c4b5fd !important; border: 1px solid #6d28d9 !important;
            border-radius: 4px !important; outline: none !important;
        }
        #omini-sync-card-premium input:focus, #omini-sync-card-premium textarea:focus { border-color: #a78bfa !important; }
        #omini-sync-card-premium button {
            background: linear-gradient(135deg, #6d28d9, #8b5cf6) !important; color: #fff !important;
            border: 1px solid #a78bfa !important; box-shadow: 0 0 10px rgba(139, 92, 246, 0.4) !important;
            border-radius: 4px !important; font-weight: 900 !important; cursor: pointer !important; transition: 0.2s !important;
        }
        #omini-sync-card-premium button:hover { filter: brightness(1.2) !important; }

        /* Botão Inline da Tabela (Roxo TVS) */
        .btn-sync-inline {
            background: linear-gradient(135deg, #6d28d9, #8b5cf6); color: white; border: none; border-radius: 4px;
            padding: 5px 12px; font-size: 12px; font-weight: bold; cursor: pointer; margin-left: 8px; margin-top: 4px;
            box-shadow: 0 0 8px rgba(139, 92, 246, 0.4); transition: 0.2s; vertical-align: middle; display: inline-block;
        }
        .btn-sync-inline:hover { filter: brightness(1.2); }
    `;
    document.head.appendChild(stylePremium);

    // ==========================================
    // 🟣 A BOLHA M NO TOPO DA TELA
    // ==========================================
    const wrapper = document.createElement('div');
    wrapper.id = 'omini-bolha-tvs-wrapper';
    wrapper.style.cssText = `position: fixed !important; top: 130px !important; right: 15px !important; z-index: 2147483647 !important; display: flex; flex-direction: column; align-items: flex-end; gap: 10px;`;

    const bolha = document.createElement('div');
    bolha.id = 'omini-bolha-tvs-btn';
    bolha.style.cssText = `width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, #4c1d95, #7c3aed); display: flex; justify-content: center; align-items: center; font-size: 20px; cursor: pointer; box-shadow: 0 0 15px rgba(139, 92, 246, 0.6), inset 0 0 8px rgba(139, 92, 246, 0.4); border: 2px solid #a78bfa; transition: transform 0.2s, background 0.2s; user-select: none;`;
    bolha.innerHTML = `<span style="font-size: 22px; font-weight: 900; font-style: italic; color: #fff; filter: drop-shadow(0 0 5px #a78bfa);">M</span>`;

    function bolhaEstadoAberto() {
        bolha.innerHTML = `❌`; bolha.style.background = `linear-gradient(135deg, #450a0a, #991b1b)`; bolha.style.borderColor = `#ff0055`;
    }

    function bolhaEstadoFechado() {
        bolha.innerHTML = `<span style="font-size: 22px; font-weight: 900; font-style: italic; color: #fff; filter: drop-shadow(0 0 5px #a78bfa);">M</span>`;
        bolha.style.background = `linear-gradient(135deg, #4c1d95, #7c3aed)`; bolha.style.borderColor = `#a78bfa`;
    }

    function acionarScriptMaster() {
        let linkDoWorkerTVS = 'https://tvsmastersync.lucassheiksk41.workers.dev';
        let s = document.createElement('script');
        s.src = linkDoWorkerTVS + '?t=' + Date.now();
        document.body.appendChild(s);
        bolhaEstadoAberto();
    }

    bolha.onclick = () => {
        bolha.style.transform = 'scale(0.8)';
        setTimeout(() => bolha.style.transform = 'none', 150);

        let btnFechar = Array.from(document.querySelectorAll('*')).find(e => e.innerText && e.innerText.trim() === '❌ Fechar');
        if (btnFechar && btnFechar.offsetHeight > 0) {
            btnFechar.click(); bolhaEstadoFechado();
        } else {
            acionarScriptMaster();
        }
    };

    wrapper.appendChild(bolha);
    document.body.appendChild(wrapper);

    // ==========================================
    // ⚡ INJETOR DE BOTÕES NAS LINHAS DA TABELA (TVS)
    // ==========================================
    function injetarBotoesNaTabela() {
        const linhas = document.querySelectorAll('table tbody tr');

        linhas.forEach(linha => {
            const cols = linha.querySelectorAll('td');
            if(cols.length < 5) return;

            const colunaAcoes = cols[cols.length - 1]; // Geralmente a última coluna tem as ações (+30 / Menu)

            // Só injeta se ainda não tiver o botão
            if (colunaAcoes && !linha.querySelector('.btn-sync-inline')) {

                // 🕵️ RADAR INTELIGENTE (Procura a coluna Status para não se perder)
                let statusIdx = -1;
                for (let j = 0; j < Math.min(6, cols.length); j++) {
                    let txt = cols[j].innerText.trim().toLowerCase();
                    if (txt === 'ativo' || txt === 'inativo' || txt === 'bloqueado' || txt.includes('vencido') || txt.includes('expirado') || txt === 'teste') {
                        statusIdx = j;
                        break;
                    }
                }

                // Se achou o status e tem colunas suficientes para trás e para frente
                if (statusIdx >= 2) {
                    let usuario = cols[statusIdx - 2].innerText.trim().split('\n')[0].trim();
                    let notas = cols[statusIdx + 2] ? cols[statusIdx + 2].innerText.trim() : '';

                    if (usuario !== '') {
                        const btnSync = document.createElement('button');
                        btnSync.className = 'btn-sync-inline';
                        btnSync.innerHTML = '🔄 Sync Master';

                        btnSync.onclick = (e) => {
                            e.preventDefault();
                            e.stopPropagation();

                            btnSync.innerHTML = '⚡ Abrindo...';
                            btnSync.style.background = '#f59e0b';

                            // Extrai o MAC do meio das notas
                            let macEncontrado = "";
                            const regexMac = /([0-9a-fA-F]{2}[:-]){5}([0-9a-fA-F]{2})/i;
                            const match = notas.match(regexMac);
                            if (match) macEncontrado = match[0];
                            if (!macEncontrado) macEncontrado = notas;

                            // 1. Atualiza a memória global (Caso o Worker do TVS use isso)
                            window.lastTvsData = { u: usuario, p: '', e: '', n: notas };

                            // 2. Camuflagem DOM (Caso o Worker leia da tela)
                            let spoofDiv = document.getElementById('omini-spoof-dom');
                            if (!spoofDiv) {
                                spoofDiv = document.createElement('div');
                                spoofDiv.id = 'omini-spoof-dom';
                                spoofDiv.style.display = 'none';
                                document.body.appendChild(spoofDiv);
                            }
                            spoofDiv.innerHTML = `
                                <input id="username" name="username" value="${usuario}">
                                <input id="usuario" name="usuario" value="${usuario}">
                                <textarea id="notes" name="notes">${macEncontrado}</textarea>
                                <textarea id="comentarios" name="comentarios">${macEncontrado}</textarea>
                                <input id="mac" name="mac" value="${macEncontrado}">
                            `;

                            // 3. Dispara a janela do MasterX instantaneamente
                            acionarScriptMaster();

                            // 4. Preenchimento Forçado do Card
                            let tentativas = 0;
                            let watcher = setInterval(() => {
                                tentativas++;
                                let modal = document.getElementById('omini-sync-card-premium') || document.querySelector('div[style*="z-index: 2147483646"]');
                                if (modal) {
                                    let inputs = modal.querySelectorAll('input');
                                    let textareas = modal.querySelectorAll('textarea');

                                    if (inputs.length > 0 && inputs[0].value === '') inputs[0].value = usuario;

                                    if (textareas.length > 0 && textareas[0].value === '') {
                                        textareas[0].value = macEncontrado;
                                    } else if (inputs.length > 2 && inputs[inputs.length-1].value === '') {
                                        inputs[inputs.length-1].value = macEncontrado;
                                    }
                                    clearInterval(watcher);
                                }
                                if (tentativas > 20) clearInterval(watcher);
                            }, 200);

                            // Devolve o visual do botão
                            setTimeout(() => {
                                btnSync.innerHTML = '🔄 Sync Master';
                                btnSync.style.background = 'linear-gradient(135deg, #6d28d9, #8b5cf6)';
                            }, 1500);
                        };

                        colunaAcoes.appendChild(btnSync);
                    }
                }
            }
        });
    }

    // ==========================================
    // 🛡️ O CÃO DE GUARDA (Mantém a Janela formatada)
    // ==========================================
    setInterval(() => {
        injetarBotoesNaTabela();

        let btnFechar = Array.from(document.querySelectorAll('*')).find(e => e.innerText && e.innerText.trim() === '❌ Fechar');

        if (btnFechar) {
            let card = btnFechar.parentElement;
            while(card && card.tagName === 'DIV') {
                let bg = window.getComputedStyle(card).backgroundColor;
                if (bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') break;
                card = card.parentElement;
            }

            if (card && !card.dataset.ominiFormatado) {
                card.dataset.ominiFormatado = "sim";
                card.id = "omini-sync-card-premium";

                let backdrop = card.parentElement;
                if (backdrop && window.getComputedStyle(backdrop).position === 'fixed') {
                    backdrop.style.background = 'transparent';
                    backdrop.style.pointerEvents = 'none';
                    card.style.pointerEvents = 'auto';
                }

                card.style.position = 'fixed';
                card.style.top = '130px';
                card.style.left = 'auto';
                card.style.bottom = 'auto';
                card.style.right = '75px';
                card.style.transform = 'scale(0.85)';
                card.style.transformOrigin = 'top right';
                card.style.margin = '0';
                card.style.zIndex = '2147483646';

                document.body.style.overflow = 'auto';

                btnFechar.addEventListener('click', () => {
                    bolhaEstadoFechado();
                });
            }
        }
    }, 500);
})();
