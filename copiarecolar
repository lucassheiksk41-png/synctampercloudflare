// ==UserScript==
// @name         SYNC MASTER - DNA (Renovação Expressa)
// @namespace    http://tampermonkey.net/
// @version      8.7
// @description  Bolha M Inteligente (Data +1 Fuso, Nome Completo na Observação)
// @author       Comandante & Omini
// @match        *://cms.omini.fit/*
// @match        *://*.omini.fit/*
// @match        *://*.dna-go.com/*
// @match        *://*.dnago.com/*
// @match        *://painel.dnago/*
// @match        *://*/*dnago*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    if (document.getElementById('omini-bolha-master-wrapper')) return;

    console.log("🟦 SYNC MASTER: Iniciando Versão 8.7 (Sniper de Vencimento com +1 Dia)...");

    // ==========================================
    // 🎨 ESTILOS PREMIUM
    // ==========================================
    const stylePremium = document.createElement('style');
    stylePremium.innerHTML = `
        #omini-sync-card-premium {
            background: #0f172a !important; border: 1px solid #0ea5e9 !important; border-radius: 8px !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.9), 0 0 10px rgba(14, 165, 233, 0.3) !important; font-family: 'Segoe UI', sans-serif !important;
        }
        #omini-sync-card-premium * { color: #f8fafc !important; border-color: #334155 !important; }
        #omini-sync-card-premium input, #omini-sync-card-premium textarea, #omini-sync-card-premium select {
            background: #020617 !important; color: #38bdf8 !important; border: 1px solid #0369a1 !important; border-radius: 4px !important; outline: none !important;
        }
        #omini-sync-card-premium input:focus, #omini-sync-card-premium textarea:focus { border-color: #38bdf8 !important; }
        #omini-sync-card-premium button {
            background: linear-gradient(135deg, #0284c7, #0ea5e9) !important; color: #fff !important; border: 1px solid #38bdf8 !important;
            box-shadow: 0 0 10px rgba(14, 165, 233, 0.4) !important; border-radius: 4px !important; font-weight: 900 !important; cursor: pointer !important; transition: 0.2s !important;
        }
        #omini-sync-card-premium button:hover { filter: brightness(1.2) !important; }
        .btn-sync-inline {
            background: linear-gradient(135deg, #0284c7, #0ea5e9); color: white; border: none; border-radius: 4px; padding: 5px 12px; font-size: 12px;
            font-weight: bold; cursor: pointer; margin-left: 8px; margin-top: 4px; box-shadow: 0 0 8px rgba(14, 165, 233, 0.4); transition: 0.2s; display: inline-block;
        }
        .btn-sync-inline:hover { filter: brightness(1.2); }
    `;
    document.head.appendChild(stylePremium);

    // ==========================================
    // 🧠 SCANNER UNIVERSAL DE TELA
    // ==========================================
    function forcarPreenchimentoDOM() {
        let texto = document.body.innerText || "";
        
        // 1. Extrair Usuário
        let user = "";
        let mUser = texto.match(/Usu[aá]rio[\s\n]*([A-Za-z0-9_.-]+)/i);
        if (mUser) user = mUser[1].trim();

        // 2. Extrair Senha
        let pass = "";
        let mPass = texto.match(/Senha[\s\n]*([A-Za-z0-9_.-]+)/i);
        if (mPass) {
            pass = mPass[1].trim();
            pass = pass.replace(/visibility|remove_red_eye/ig, '').trim(); 
        }

        // 3. Extrair Data de Expiração e ADICIONAR 1 DIA (+1 Fuso)
        let dataExp = "";
        let splitVencimento = texto.split(/Vencimento/i);
        if (splitVencimento.length > 1) {
            let matchData = splitVencimento[1].match(/(\d{2})\/(\d{2})\/(\d{4})/);
            if (matchData) {
                let dia = parseInt(matchData[1], 10);
                let mes = parseInt(matchData[2], 10) - 1; // JS conta meses de 0 a 11
                let ano = parseInt(matchData[3], 10);

                // Cria o calendário e soma 1 dia
                let dataCalculada = new Date(ano, mes, dia);
                dataCalculada.setDate(dataCalculada.getDate() + 1);

                // Formata de volta para YYYY-MM-DD
                let novoDia = String(dataCalculada.getDate()).padStart(2, '0');
                let novoMes = String(dataCalculada.getMonth() + 1).padStart(2, '0');
                let novoAno = dataCalculada.getFullYear();

                dataExp = `${novoAno}-${novoMes}-${novoDia}`;
            }
        }

        // 4. Extrair Nome Completo e MAC
        let notesText = "";
        let splitObs = texto.split(/Observa[çc][õo]es/i);
        if (splitObs.length > 1) {
            let linhas = splitObs[1].split('\n').map(l => l.trim()).filter(l => l.length > 2 && !l.match(/Atividade/i));
            if (linhas.length > 0) notesText = linhas[0]; 
        }

        // Cria a armadilha de dados pro MasterX ler na retaguarda
        let spoofDiv = document.getElementById('omini-spoof-dom');
        if (!spoofDiv) {
            spoofDiv = document.createElement('div');
            spoofDiv.id = 'omini-spoof-dom';
            spoofDiv.style.display = 'none';
            document.body.appendChild(spoofDiv);
        }

        if(user || pass || notesText || dataExp) {
            spoofDiv.innerHTML = `
                <input id="username" name="username" value="${user}">
                <input id="password" name="password" value="${pass}">
                <input id="expire_date" name="expire_date" value="${dataExp}">
                <textarea id="notes" name="notes">${notesText}</textarea>
            `;
        }
        return { user, pass, dataExp, notesText };
    }

    // ==========================================
    // 🎯 INJETOR FORÇADO NO MODAL MASTERX
    // ==========================================
    function injetarValoresNoModal(dados) {
        let tentativas = 0;
        let watcher = setInterval(() => {
            tentativas++;
            let modal = document.getElementById('omini-sync-card-premium') || document.querySelector('div[style*="z-index: 2147483646"]');
            if (modal) {
                let inputs = modal.querySelectorAll('input');
                if(inputs.length >= 4) {
                    if(inputs[0].value === '' && dados.user) inputs[0].value = dados.user;
                    if(inputs[1].value === '' && dados.pass) inputs[1].value = dados.pass;
                    if(inputs[2].value === '' && dados.dataExp) inputs[2].value = dados.dataExp;
                    if(inputs[3].value === '' && dados.notesText) inputs[3].value = dados.notesText;
                } 
                else if (inputs.length > 0 && inputs[inputs.length-1].value === '' && dados.notesText) {
                    inputs[inputs.length-1].value = dados.notesText;
                }
                clearInterval(watcher);
            }
            if (tentativas > 25) clearInterval(watcher);
        }, 200);
    }

    // ==========================================
    // 🔵 A BOLHA M NO TOPO DA TELA
    // ==========================================
    const wrapper = document.createElement('div');
    wrapper.id = 'omini-bolha-master-wrapper';
    wrapper.style.cssText = `position: fixed !important; top: 130px !important; right: 15px !important; z-index: 2147483647 !important; display: flex; flex-direction: column; align-items: flex-end; gap: 10px;`;

    const bolha = document.createElement('div');
    bolha.id = 'omini-bolha-master-btn';
    bolha.style.cssText = `width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, #0369a1, #0ea5e9); display: flex; justify-content: center; align-items: center; font-size: 20px; cursor: pointer; box-shadow: 0 0 15px rgba(14, 165, 233, 0.6), inset 0 0 8px rgba(14, 165, 233, 0.4); border: 2px solid #22d3ee; transition: transform 0.2s, background 0.2s; user-select: none;`;
    bolha.innerHTML = `<span style="font-size: 22px; font-weight: 900; font-style: italic; color: #fff; filter: drop-shadow(0 0 5px #22d3ee);">M</span>`;

    function bolhaEstadoFechado() {
        bolha.innerHTML = `<span style="font-size: 22px; font-weight: 900; font-style: italic; color: #fff; filter: drop-shadow(0 0 5px #22d3ee);">M</span>`;
        bolha.style.background = `linear-gradient(135deg, #0369a1, #0ea5e9)`; bolha.style.borderColor = `#22d3ee`;
    }

    bolha.onclick = () => {
        bolha.style.transform = 'scale(0.8)';
        setTimeout(() => bolha.style.transform = 'none', 150);

        let btnFechar = Array.from(document.querySelectorAll('*')).find(e => e.innerText && e.innerText.trim() === '❌ Fechar');
        if (btnFechar && btnFechar.offsetHeight > 0) {
            btnFechar.click(); bolhaEstadoFechado();
        } else {
            let dadosExtraidos = forcarPreenchimentoDOM(); 
            let s = document.createElement('script');
            s.src = 'https://syncmaster.lucassheiksk41.workers.dev?t=' + Date.now();
            document.body.appendChild(s);
            bolha.innerHTML = `❌`; bolha.style.background = `linear-gradient(135deg, #450a0a, #991b1b)`; bolha.style.borderColor = `#ff0055`;
            injetarValoresNoModal(dadosExtraidos);
        }
    };

    wrapper.appendChild(bolha);
    document.body.appendChild(wrapper);

    // ==========================================
    // ⚡ INJETOR: BOTÕES NAS LINHAS DA TABELA GERAL
    // ==========================================
    function injetarBotoesNaTabela() {
        const linhas = document.querySelectorAll('table tbody tr');
        linhas.forEach(linha => {
            const colunas = linha.querySelectorAll('td');
            if(colunas.length < 6) return; 

            const colunaAcoes = colunas[colunas.length - 1]; 
            let username = colunas[1] ? colunas[1].innerText.trim().split('\n')[0].trim() : '';

            if (colunaAcoes && username !== '' && !linha.querySelector('.btn-sync-inline')) {
                const btnSync = document.createElement('button');
                btnSync.className = 'btn-sync-inline';
                btnSync.innerHTML = '🔄 Sync Master';
                btnSync.onclick = (e) => {
                    e.preventDefault();
                    btnSync.innerHTML = '⚡ Abrindo...';
                    btnSync.style.background = '#f59e0b';

                    let comentarios = colunas[5] ? colunas[5].innerText.trim() : '';
                    let spoofDiv = document.getElementById('omini-spoof-dom') || document.createElement('div');
                    spoofDiv.id = 'omini-spoof-dom'; spoofDiv.style.display = 'none';
                    spoofDiv.innerHTML = `<input id="username" value="${username}"><textarea id="notes">${comentarios}</textarea>`;
                    if(!document.getElementById('omini-spoof-dom')) document.body.appendChild(spoofDiv);

                    bolha.click(); 
                    setTimeout(() => { btnSync.innerHTML = '🔄 Sync Master'; btnSync.style.background = 'linear-gradient(135deg, #0284c7, #0ea5e9)'; }, 1500);
                };
                colunaAcoes.appendChild(btnSync);
            }
        });
    }

    // ==========================================
    // 🛡️ CÃO DE GUARDA DO MODAL
    // ==========================================
    setInterval(() => {
        injetarBotoesNaTabela();
        let btnFechar = Array.from(document.querySelectorAll('*')).find(e => e.innerText && e.innerText.trim() === '❌ Fechar');
        if (btnFechar) {
            let card = btnFechar.parentElement;
            while(card && card.tagName === 'DIV') {
                let bg = window.getComputedStyle(card).backgroundColor;
                if (bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') break;
                card = card.parentElement;
            }
            if (card && !card.dataset.ominiFormatado) {
                card.dataset.ominiFormatado = "sim"; card.id = "omini-sync-card-premium";
                card.style.position = 'fixed'; card.style.top = '130px'; card.style.right = '75px'; card.style.zIndex = '2147483646';
                btnFechar.addEventListener('click', bolhaEstadoFechado);
            }
        }
    }, 500);
})();
